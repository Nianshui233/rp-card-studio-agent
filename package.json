{
  "name": "rp-card-studio-agent",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Lean SillyTavern RP brainstorming, authoring, QA, final inspection, and delivery agent.",
  "scripts": {
    "check": "node scripts/check-examples.mjs",
    "test": "node scripts/run-tests.mjs",
    "dsh:build": "node .dsh/build.mjs",
    "dsh:check": "node .dsh/build.mjs --check",
    "dsh:install": "node .dsh/install.mjs",
    "dsh:verify": "node .dsh/verify.mjs",
    "test:dsh": "node --test --test-reporter=spec .dsh/adapter-contract.test.mjs",
    "artifact:check": "node scripts/delivery/deliverable-check.mjs",
    "production:init": "node scripts/production/production-check.mjs init",
    "production:check": "node scripts/production/production-check.mjs validate",
    "production:claim": "node scripts/production/production-check.mjs claim",
    "mvu:build": "node scripts/mvu/mvu-zod-project.mjs build",
    "mvu:check": "node scripts/mvu/mvu-zod-project.mjs validate",
    "test:frontend": "node tests/frontend-browser.mjs",
    "project:verify": "node scripts/production/check-plan.mjs",
    "frontend:check": "node scripts/frontend/run-browser-fixtures.mjs",
    "frontend:preview": "node scripts/frontend/preview-layout.mjs",
    "frontend:design": "node scripts/frontend/design-guide.mjs",
    "frontend:library": "node scripts/frontend/design-library.mjs",
    "frontend:workbench": "node scripts/frontend/frontend-workbench.mjs",
    "frontend:tune": "node scripts/frontend/tuning-backport.mjs",
    "install:check": "node scripts/install/verify-install.mjs",
    "test:design-tools": "node tests/design-tools-browser.mjs",
    "worldbook:check": "node scripts/worldbook/worldbook-check.mjs",
    "host:discover": "node scripts/host/discover-sillytavern.mjs",
    "qa:auto": "node scripts/production/automatic-qa.mjs"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.25.10",
    "lodash-es": "4.17.21",
    "lucide": "1.55.0",
    "parse5": "8.0.1",
    "postcss": "8.5.29",
    "yaml": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
