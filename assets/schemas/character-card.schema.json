{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/character-card.schema.json",
  "title": "SillyTavern Character Card V2/V3 Artifact",
  "type": "object",
  "required": ["spec", "spec_version", "data"],
  "oneOf": [
    {
      "title": "Character Card V2",
      "properties": {
        "spec": { "const": "chara_card_v2" },
        "spec_version": { "const": "2.0" },
        "data": { "$ref": "#/$defs/v2Data" }
      }
    },
    {
      "title": "Character Card V3",
      "properties": {
        "spec": { "const": "chara_card_v3" },
        "spec_version": { "$ref": "#/$defs/v3Version" },
        "data": {
          "type": "object",
          "properties": {
            "extensions": { "$ref": "#/$defs/characterExtensions" }
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "v3Version": {
      "oneOf": [
        { "type": "string", "pattern": "^3(?:\\.[0-9]+)?$" },
        { "type": "number", "minimum": 3, "exclusiveMaximum": 4 }
      ]
    },
    "v2Data": {
      "type": "object",
      "required": ["name", "description", "personality", "scenario", "first_mes", "mes_example", "creator_notes", "system_prompt", "post_history_instructions", "alternate_greetings", "tags", "creator", "character_version", "extensions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "personality": { "type": "string" },
        "scenario": { "type": "string" },
        "first_mes": { "type": "string" },
        "mes_example": { "type": "string" },
        "creator_notes": { "type": "string" },
        "system_prompt": { "type": "string" },
        "post_history_instructions": { "type": "string" },
        "alternate_greetings": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "creator": { "type": "string" },
        "character_version": { "type": "string" },
        "extensions": { "$ref": "#/$defs/characterExtensions" },
        "character_book": { "$ref": "#/$defs/characterBook" }
      },
      "additionalProperties": true
    },
    "characterExtensions": {
      "type": "object",
      "properties": {
        "regex_scripts": {
          "type": "array",
          "items": { "$ref": "#/$defs/regexScript" }
        }
      },
      "additionalProperties": true
    },
    "regexScript": {
      "type": "object",
      "required": ["id", "scriptName", "findRegex", "replaceString", "trimStrings", "placement", "disabled", "markdownOnly", "promptOnly", "runOnEdit", "substituteRegex", "minDepth", "maxDepth"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
        "scriptName": { "type": "string", "minLength": 1 },
        "findRegex": { "type": "string", "minLength": 1 },
        "replaceString": { "type": "string" },
        "trimStrings": { "type": "array", "items": { "type": "string" } },
        "placement": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": [0, 1, 2, 3, 5, 6] }
        },
        "disabled": { "type": "boolean" },
        "markdownOnly": { "type": "boolean" },
        "promptOnly": { "type": "boolean" },
        "runOnEdit": { "type": "boolean" },
        "substituteRegex": { "enum": [0, 1, 2] },
        "minDepth": { "type": ["integer", "null"], "minimum": -1 },
        "maxDepth": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "characterBook": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "scan_depth": { "type": ["integer", "null"], "minimum": 0 },
        "token_budget": { "type": ["integer", "null"], "minimum": 0 },
        "recursive_scanning": { "type": ["boolean", "null"] },
        "extensions": { "type": "object" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "keys", "secondary_keys", "comment", "content", "constant", "selective", "insertion_order", "enabled", "position", "extensions"],
            "properties": {
              "id": { "type": ["integer", "string"] },
              "keys": { "type": "array", "items": { "type": "string" } },
              "secondary_keys": { "type": "array", "items": { "type": "string" } },
              "comment": { "type": "string" },
              "content": { "type": "string" },
              "constant": { "type": "boolean" },
              "selective": { "type": "boolean" },
              "insertion_order": { "type": "integer" },
              "enabled": { "type": "boolean" },
              "position": { "type": "string" },
              "extensions": { "type": "object" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}

