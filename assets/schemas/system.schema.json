{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/system.schema.json",
  "title": "System Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "status", "purpose", "axes", "rules", "settlement_order", "invariants", "failure_modes", "source_refs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "locked"] },
    "purpose": { "type": "string" },
    "axes": { "type": "array", "items": { "$ref": "#/$defs/axis" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "state_machines": { "type": "array", "items": { "$ref": "#/$defs/stateMachine" } },
    "settlement_order": { "$ref": "#/$defs/stringList" },
    "invariants": { "$ref": "#/$defs/stringList" },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "condition", "fallback"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "condition": { "type": "string", "minLength": 1 },
          "fallback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "subject", "type", "initial", "constraints", "visibility", "updates", "thresholds", "boundary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "integer", "number", "boolean", "enum", "object", "array"] },
        "initial": {},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "values": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] }, "uniqueItems": true },
            "pattern": { "type": "string" },
            "max_items": { "type": "integer", "minimum": 0 }
          }
        },
        "visibility": { "enum": ["exact", "descriptive_band", "change_cues", "hidden"] },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "when", "operation", "value", "frequency"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "when": { "type": "string", "minLength": 1 },
              "operation": { "enum": ["set", "add", "subtract", "append", "remove", "move", "derive"] },
              "value": {},
              "frequency": { "type": "string", "minLength": 1 },
              "maximum_change": { "type": "number", "minimum": 0 }
            }
          }
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "minimum", "maximum", "effect"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "minimum": { "type": "number" },
              "maximum": { "type": "number" },
              "effect": { "type": "string", "minLength": 1 }
            }
          }
        },
        "boundary": { "type": "string" }
      }
    },
    "stateEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_id", "operation"],
      "properties": {
        "axis_id": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["set", "add", "subtract", "append", "remove", "move", "derive"] },
        "value": {},
        "maximum_change": { "type": "number", "minimum": 0 }
      }
    },
    "machineState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1 },
        "terminal": { "type": "boolean" },
        "entry": { "type": "array", "items": { "$ref": "#/$defs/stateEffect" } },
        "exit": { "type": "array", "items": { "$ref": "#/$defs/stateEffect" } },
        "entry_effects": { "type": "array", "items": { "$ref": "#/$defs/stateEffect" } },
        "exit_effects": { "type": "array", "items": { "$ref": "#/$defs/stateEffect" } }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "trigger"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
          ]
        },
        "to": { "$ref": "#/$defs/id" },
        "trigger": { "type": "string", "minLength": 1 },
        "guard": { "type": "string", "minLength": 1 },
        "guards": { "$ref": "#/$defs/stringList" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/stateEffect" } },
        "priority": { "type": "integer" },
        "reset": { "type": "boolean" }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "to"],
      "properties": {
        "trigger": { "type": "string", "minLength": 1 },
        "to": { "$ref": "#/$defs/id" },
        "guards": { "$ref": "#/$defs/stringList" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/stateEffect" } }
      }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state_axis_id", "initial_state", "states", "transitions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1 },
        "state_axis_id": { "$ref": "#/$defs/id" },
        "initial_state": { "$ref": "#/$defs/id" },
        "enforcement": { "enum": ["narrative", "runtime_preferred", "runtime_required"] },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/machineState" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "resets": { "type": "array", "items": { "$ref": "#/$defs/reset" } },
        "reset": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/reset" }
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "trigger", "conditions", "effects", "frequency", "anti_farming"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["coupling", "settlement", "invariant"] },
        "trigger": { "type": "string", "minLength": 1 },
        "conditions": { "$ref": "#/$defs/stringList" },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis_id", "operation"],
            "properties": {
              "axis_id": { "$ref": "#/$defs/id" },
              "operation": { "enum": ["set", "add", "subtract", "append", "remove", "move", "derive"] },
              "value": {},
              "maximum_change": { "type": "number", "minimum": 0 }
            }
          }
        },
        "frequency": { "type": "string", "minLength": 1 },
        "anti_farming": { "type": ["string", "null"] }
      }
    }
  }
}
