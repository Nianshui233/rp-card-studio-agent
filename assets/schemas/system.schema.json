{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/system.schema.json",
  "title": "RP System Source",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "id", "display_name", "status", "purpose",
    "roleplay_experience", "core_rules", "triggers", "consequences",
    "world_and_npc_motion", "exceptions", "anti_exploitation",
    "state_to_remember", "examples", "source_refs"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "locked"] },
    "system_mode": { "enum": ["narrative", "quantitative", "hybrid"] },
    "purpose": { "type": "string" },
    "roleplay_experience": { "type": "string" },
    "core_rules": { "type": "array" },
    "triggers": { "type": "array" },
    "consequences": { "type": "array" },
    "world_and_npc_motion": { "type": "array" },
    "exceptions": { "type": "array" },
    "anti_exploitation": { "type": "array" },
    "state_to_remember": { "type": "array" },
    "examples": { "type": "array" },
    "quantitative": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "display": { "type": "object" },
        "axes": { "type": "array" },
        "calculation": { "type": "object" },
        "boundaries": { "type": "object" },
        "decay_or_recovery": { "type": "array" },
        "anti_exploitation": { "type": "array" },
        "cross_axis_interactions": { "type": "array" },
        "conflict_priority": { "type": "array" },
        "worked_examples": { "type": "array" }
      }
    },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "system_mode": { "enum": ["quantitative", "hybrid"] } },
        "required": ["system_mode"]
      },
      "then": {
        "required": ["quantitative"],
        "properties": { "quantitative": { "type": "object" } }
      }
    }
  ]
}
