{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/scene.schema.json",
  "title": "RP Scene Source",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "id", "display_name", "status", "purpose", "daily_life",
    "atmosphere", "space_and_access", "actors_and_motion", "interactions",
    "risks", "clues", "events", "secrets", "long_term_changes", "source_refs"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "locked"] },
    "purpose": { "type": "string" },
    "scene_type": { "type": "string" },
    "play_focus": { "type": "array" },
    "depth_profile": { "type": "string" },
    "daily_life": { "type": "string" },
    "atmosphere": { "type": "array" },
    "spatial_structure": { "type": "object" },
    "access_and_security": { "type": "object" },
    "space_and_access": { "type": "array" },
    "actors_and_motion": { "type": "array" },
    "interactions": { "type": "array" },
    "risks": { "type": "array" },
    "resources_and_changes": { "type": "object" },
    "clue_structure": { "type": "array" },
    "time_and_events": { "type": "object" },
    "local_rules": { "type": "object" },
    "clues": { "type": "array" },
    "events": { "type": "array" },
    "secrets": { "type": "array" },
    "long_term_changes": { "type": "array" },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  }
}
