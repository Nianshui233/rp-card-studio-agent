{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/status-ui.schema.json",
  "title": "Status UI Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "status_ui"],
  "properties": {
    "schema_version": { "const": "1.2.0" },
    "status": { "enum": ["draft", "locked"] },
    "status_ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "read_only", "refresh", "text_template", "sections", "commands", "states", "responsive", "visual", "accessibility", "dependencies", "delivery"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "enum": ["none", "text", "embedded", "both"],
          "description": "Presentation shape. For the regex adapter, both means HTML with a readable text summary in the same projection, not an automatic runtime fallback."
        },
        "read_only": { "type": "boolean" },
        "refresh": { "enum": ["on_message", "on_state_change", "manual", "hybrid"] },
        "text_template": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "display_name", "priority", "collapsed", "fields"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "display_name": { "type": "string", "minLength": 1 },
              "priority": { "type": "integer", "minimum": 0 },
              "collapsed": { "type": "boolean" },
              "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
              "content_class": { "enum": ["standard", "nsfw"] }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "channel", "payload", "writer_id"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "minLength": 1 },
              "channel": { "enum": ["chat_command", "runtime_event", "script_api"] },
              "payload": { "type": "string", "minLength": 1 },
              "writer_id": { "$ref": "#/$defs/id" }
            }
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loading", "empty", "error", "degraded"],
          "description": "Design copy for runtime states. A pure SillyTavern regex projection cannot detect or switch among these states; conditional behavior requires a verified Tavern Helper message runtime.",
          "properties": {
            "loading": { "type": "string", "minLength": 1 },
            "empty": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 },
            "degraded": { "type": "string", "minLength": 1 }
          }
        },
        "responsive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["narrow", "wide"],
          "description": "Responsive design intent. Static single-column, compact-list, and grouped-column layouts are compatible with regex HTML; tabs require a Tavern Helper message runtime.",
          "properties": {
            "narrow": { "enum": ["single_column", "compact_list", "tabs"] },
            "wide": { "enum": ["single_column", "grouped_columns", "tabs"] }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["density", "hierarchy", "motion"],
          "properties": {
            "density": { "enum": ["pending", "compact", "comfortable", "spacious"] },
            "hierarchy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "motion": { "enum": ["pending", "none", "restrained", "expressive"] }
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyboard", "live_updates", "color_independent"],
          "description": "Accessibility intent. Regex HTML can emit semantic markup and ARIA attributes, but runtime announcement behavior still requires host verification.",
          "properties": {
            "keyboard": { "type": "boolean" },
            "live_updates": { "enum": ["off", "polite", "assertive"] },
            "color_independent": { "type": "boolean" }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "class", "delivery", "fallback"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "class": { "enum": ["builtin", "embedded", "host_required", "remote", "development_only"] },
              "delivery": { "type": "string", "minLength": 1 },
              "fallback": {
                "type": "string",
                "minLength": 1,
                "description": "Dependency handling note. It does not add a third UI surface or make a regex projection conditionally switch views."
              }
            }
          }
        },
        "delivery": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/delivery" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": false } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "mode": { "const": "none" },
              "delivery": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "mode": { "enum": ["text", "embedded", "both"] },
              "delivery": { "$ref": "#/$defs/delivery" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": { "const": true },
              "delivery": {
                "type": "object",
                "properties": {
                  "entrypoint": { "const": "generated" },
                  "artifact": { "const": "inline" }
                },
                "required": ["entrypoint", "artifact"]
              }
            },
            "required": ["enabled", "delivery"]
          },
          "then": {
            "properties": {
              "read_only": { "const": true },
              "refresh": { "const": "on_message" },
              "commands": { "type": "array", "maxItems": 0 },
              "responsive": {
                "type": "object",
                "properties": {
                  "narrow": { "enum": ["single_column", "compact_list"] },
                  "wide": { "enum": ["single_column", "grouped_columns"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"],
            "anyOf": [
              {
                "properties": { "read_only": { "const": false } },
                "required": ["read_only"]
              },
              {
                "properties": { "refresh": { "enum": ["on_state_change", "manual", "hybrid"] } },
                "required": ["refresh"]
              },
              {
                "properties": { "commands": { "type": "array", "minItems": 1 } },
                "required": ["commands"]
              },
              {
                "properties": {
                  "responsive": {
                    "type": "object",
                    "properties": { "narrow": { "const": "tabs" } },
                    "required": ["narrow"]
                  }
                },
                "required": ["responsive"]
              },
              {
                "properties": {
                  "responsive": {
                    "type": "object",
                    "properties": { "wide": { "const": "tabs" } },
                    "required": ["wide"]
                  }
                },
                "required": ["responsive"]
              }
            ]
          },
          "then": {
            "properties": {
              "delivery": {
                "type": "object",
                "properties": {
                  "level": { "const": "host_required" },
                  "adapter": { "const": "tavern_helper_message" },
                  "entrypoint": { "const": "host_managed" },
                  "artifact": { "const": "host_managed" }
                },
                "required": ["level", "adapter", "entrypoint", "artifact"]
              }
            }
          }
        }
      ]
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "sourcePath": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "adapter", "surface", "entrypoint", "artifact", "placeholder"],
      "description": "Message-only delivery. SillyTavern character regex is the basic embedded default. A generated Tavern Helper message iframe is an opt-in host_required candidate and remains runtime:not_run until target-host execution is proven; host-managed Tavern Helper specifications remain explicitly marked host_managed.",
      "properties": {
        "level": { "enum": ["specification", "embedded", "host_required"] },
        "adapter": { "enum": ["sillytavern_regex", "tavern_helper_message"] },
        "surface": { "const": "message" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "placeholder": { "const": "<StatusPlaceHolderImpl/>" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "level": { "const": "embedded" } },
            "required": ["level"]
          },
          "then": {
            "properties": {
              "adapter": { "const": "sillytavern_regex" },
              "entrypoint": { "const": "generated" },
              "artifact": { "const": "inline" }
            }
          }
        },
        {
          "if": {
            "properties": { "adapter": { "const": "tavern_helper_message" } },
            "required": ["adapter"]
          },
          "then": {
            "properties": {
              "level": { "enum": ["specification", "host_required"] }
            }
          }
        },
        {
          "if": {
            "properties": { "adapter": { "const": "sillytavern_regex" } },
            "required": ["adapter"]
          },
          "then": {
            "properties": {
              "level": { "enum": ["specification", "embedded"] }
            }
          }
        },
        {
          "if": {
            "properties": { "level": { "const": "host_required" } },
            "required": ["level"]
          },
          "then": {
            "properties": {
              "adapter": { "const": "tavern_helper_message" }
            },
            "oneOf": [
              {
                "properties": {
                  "entrypoint": { "const": "generated" },
                  "artifact": { "const": "inline" }
                },
                "required": ["entrypoint", "artifact"]
              },
              {
                "properties": {
                  "entrypoint": { "const": "host_managed" },
                  "artifact": { "const": "host_managed" }
                },
                "required": ["entrypoint", "artifact"]
              }
            ]
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_path", "label", "format", "missing_value", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_path": { "$ref": "#/$defs/sourcePath" },
        "label": { "type": "string", "minLength": 1 },
        "format": {
          "enum": ["string", "integer", "number", "boolean", "percent", "enum", "list", "object"],
          "description": "Display intent. Regex projections use host serialization; percent may add a literal suffix only when the upstream value is guaranteed present and already normalized to 0..100."
        },
        "missing_value": {
          "type": "string",
          "description": "Design copy for a missing value. A regex projection cannot conditionally select it after Tavern Helper expands the variable macro."
        },
        "visibility": { "const": "player" },
        "content_class": { "enum": ["standard", "nsfw"] }
      }
    }
  }
}
