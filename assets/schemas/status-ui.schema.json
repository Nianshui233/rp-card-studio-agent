{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/status-ui.schema.json",
  "title": "Message UI Application Plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "status_ui",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "status": {
      "enum": [
        "draft",
        "locked"
      ]
    },
    "status_ui": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "authoring_mode",
        "experience_level",
        "theme_direction",
        "device_priority",
        "surfaces",
        "data_sources",
        "host_interactions",
        "lifecycle_checks",
        "runtime"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authoring_mode": {
          "enum": [
            "direct_html",
            "multi_file_html",
            "compiled_frontend",
            "existing_build"
          ]
        },
        "experience_level": {
          "enum": [
            "light",
            "light_medium",
            "medium",
            "heavy",
            "super_heavy"
          ]
        },
        "data_density": {
          "enum": [
            "sparse",
            "medium",
            "rich",
            "large_cross_domain",
            "unknown"
          ]
        },
        "presentation_model": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "authoritative_paths": { "type": "array", "items": { "type": "string" } },
            "static_modules": { "type": "array", "items": { "type": "string" } },
            "derived_views": { "type": "array", "items": { "type": "string" } },
            "local_interaction_state": { "type": "array", "items": { "type": "string" } },
            "empty_state_policy": { "type": "string" },
            "unknown_state_policy": { "type": "string" }
          }
        },
        "theme_direction": {
          "type": "string"
        },
        "device_priority": {
          "enum": [
            "desktop",
            "mobile",
            "equal"
          ]
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "marker": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "app_manifest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "render_route": {
                "enum": [
                  "regex_replace",
                  "helper_script",
                  "ejs",
                  "inline_html",
                  "framework",
                  "existing"
                ]
              },
              "render_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "render_evidence": {
                "$ref": "#/$defs/stringArray"
              },
              "emission": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "producer",
                  "cadence",
                  "source_ref",
                  "evidence"
                ],
                "properties": {
                  "producer": {
                    "enum": [
                      "opening_message",
                      "model_output",
                      "framework",
                      "helper_script",
                      "user_action",
                      "existing"
                    ]
                  },
                  "cadence": {
                    "enum": [
                      "opening_only",
                      "every_assistant_message",
                      "on_change",
                      "on_demand"
                    ]
                  },
                  "source_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "prompt_channel": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "regex_ref",
                  "fallback_text",
                  "evidence"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "remove",
                      "replace",
                      "preserve",
                      "existing"
                    ]
                  },
                  "regex_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "fallback_text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "data_sources": {
          "type": "array"
        },
        "host_interactions": {
          "type": "array"
        },
        "experience_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "level_advancements",
            "primary_play_surface"
          ],
          "properties": {
            "baseline": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "navigation": {
                  "$ref": "#/$defs/stringArray"
                },
                "data_views": {
                  "$ref": "#/$defs/stringArray"
                },
                "information_tools": {
                  "$ref": "#/$defs/stringArray"
                },
                "host_actions": {
                  "$ref": "#/$defs/stringArray"
                },
                "feedback_states": {
                  "$ref": "#/$defs/stringArray"
                },
                "responsive_checks": {
                  "$ref": "#/$defs/stringArray"
                },
                "theme_features": {
                  "$ref": "#/$defs/stringArray"
                },
                "data_binding": {
                  "$ref": "#/$defs/stringArray"
                }
              }
            },
            "level_advancements": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "usability": {
                  "$ref": "#/$defs/stringArray"
                },
                "information_architecture": {
                  "$ref": "#/$defs/stringArray"
                },
                "interaction_depth": {
                  "$ref": "#/$defs/stringArray"
                },
                "visual_expression": {
                  "$ref": "#/$defs/stringArray"
                },
                "host_integration": {
                  "$ref": "#/$defs/stringArray"
                },
                "persistence_lifecycle": {
                  "$ref": "#/$defs/stringArray"
                }
              }
            },
            "primary_play_surface": {
              "type": "boolean"
            }
          }
        },
        "opening_relationship": {
          "enum": [
            "separate",
            "shared_source",
            "opening_to_runtime",
            "unified_zero_layer"
          ]
        },
        "lifecycle_checks": {
          "type": "array"
        },
        "runtime": {
          "enum": [
            "not_run",
            "pass",
            "fail",
            "blocked"
          ]
        },
        "state_contract": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "root",
            "scope",
            "refresh",
            "paths"
          ],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "message_id"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "message",
                    "chat",
                    "global"
                  ]
                },
                "message_id": {
                  "oneOf": [
                    {
                      "enum": [
                        "current",
                        "latest"
                      ]
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "refresh": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "events",
                "interval_ms"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "event",
                    "poll",
                    "event_and_poll",
                    "manual"
                  ]
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "interval_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 100
                }
              }
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "type",
                  "readers",
                  "writers",
                  "fallback"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "readers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "writers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "fallback": {},
                  "readable_by": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "writable_by": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "readonly": {
                    "type": "boolean"
                  },
                  "derived": {
                    "type": "boolean"
                  },
                  "update_guard": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "frontend_build": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "mode",
            "source_root",
            "package_file",
            "lock_file",
            "build_command",
            "output",
            "runtime_format",
            "expected_sha256"
          ],
          "properties": {
            "mode": {
              "const": "compiled_frontend"
            },
            "source_root": {
              "type": "string",
              "minLength": 1
            },
            "package_file": {
              "type": "string",
              "minLength": 1
            },
            "lock_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "build_command": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "string",
              "minLength": 1
            },
            "runtime_format": {
              "enum": [
                "standalone_document",
                "message_surface"
              ]
            },
            "expected_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "zero_layer": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "message_replacement",
            "floor_policy",
            "chat_switch",
            "primary_play_surface",
            "history_access",
            "fullscreen",
            "persistence",
            "lifecycle_script"
          ],
          "properties": {
            "message_replacement": {
              "enum": [
                "whole_message",
                "managed_region"
              ]
            },
            "floor_policy": {
              "enum": [
                "latest_only",
                "keep_history",
                "script_managed"
              ]
            },
            "chat_switch": {
              "enum": [
                "reload_application",
                "restore_application",
                "script_managed"
              ]
            },
            "primary_play_surface": {
              "type": "boolean"
            },
            "history_access": {
              "enum": [
                "through_frontend",
                "through_chat",
                "both"
              ]
            },
            "fullscreen": {
              "enum": [
                "supported",
                "not_planned",
                "existing"
              ]
            },
            "persistence": {
              "type": "array",
              "items": {
                "enum": [
                  "local_storage",
                  "message_state",
                  "chat_state",
                  "worldbook",
                  "none"
                ]
              }
            },
            "lifecycle_script": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
