{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/status-ui.schema.json",
  "title": "Direct Message UI Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "status_ui", "source_refs"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "status": { "enum": ["draft", "locked"] },
    "status_ui": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled", "authoring_mode", "experience_level", "theme_direction",
        "device_priority", "surfaces", "data_sources", "host_interactions",
        "lifecycle_checks", "runtime"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "authoring_mode": { "const": "direct_html" },
        "experience_level": { "enum": ["light", "light_medium", "medium", "heavy", "super_heavy"] },
        "theme_direction": { "type": "string" },
        "device_priority": { "enum": ["desktop", "mobile", "equal"] },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "marker": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "emission": {
                "type": "object",
                "additionalProperties": false,
                "required": ["producer", "cadence", "source_ref", "evidence"],
                "properties": {
                  "producer": {
                    "enum": ["opening_message", "model_output", "framework", "helper_script", "user_action", "existing"]
                  },
                  "cadence": {
                    "enum": ["opening_only", "every_assistant_message", "on_change", "on_demand"]
                  },
                  "source_ref": { "type": ["string", "null"] },
                  "evidence": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "data_sources": { "type": "array" },
        "host_interactions": { "type": "array" },
        "lifecycle_checks": { "type": "array" },
        "runtime": { "enum": ["not_run", "pass", "fail", "blocked"] }
      }
    },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  }
}
