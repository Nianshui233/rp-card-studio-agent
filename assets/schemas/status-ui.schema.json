{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/status-ui.schema.json",
  "title": "Message UI Application Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "status_ui", "source_refs"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "status": { "enum": ["draft", "locked"] },
    "status_ui": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled", "authoring_mode", "experience_level", "theme_direction",
        "device_priority", "surfaces", "data_sources", "host_interactions",
        "lifecycle_checks", "runtime"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "authoring_mode": { "enum": ["direct_html", "multi_file_html", "compiled_frontend", "existing_build"] },
        "experience_level": { "enum": ["light", "light_medium", "medium", "heavy", "super_heavy"] },
        "theme_direction": { "type": "string" },
        "device_priority": { "enum": ["desktop", "mobile", "equal"] },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "marker": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "app_manifest": { "type": ["string", "null"] },
              "render_route": { "enum": ["regex_replace", "helper_script", "ejs", "inline_html", "framework", "existing"] },
              "render_ref": { "type": ["string", "null"] },
              "render_evidence": { "$ref": "#/$defs/stringArray" },
              "emission": {
                "type": "object",
                "additionalProperties": false,
                "required": ["producer", "cadence", "source_ref", "evidence"],
                "properties": {
                  "producer": {
                    "enum": ["opening_message", "model_output", "framework", "helper_script", "user_action", "existing"]
                  },
                  "cadence": {
                    "enum": ["opening_only", "every_assistant_message", "on_change", "on_demand"]
                  },
                  "source_ref": { "type": ["string", "null"] },
                  "evidence": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "data_sources": { "type": "array" },
        "host_interactions": { "type": "array" },
        "experience_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "level_advancements", "primary_play_surface"],
          "properties": {
            "baseline": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "navigation": { "$ref": "#/$defs/stringArray" },
                "data_views": { "$ref": "#/$defs/stringArray" },
                "information_tools": { "$ref": "#/$defs/stringArray" },
                "host_actions": { "$ref": "#/$defs/stringArray" },
                "feedback_states": { "$ref": "#/$defs/stringArray" },
                "responsive_checks": { "$ref": "#/$defs/stringArray" },
                "theme_features": { "$ref": "#/$defs/stringArray" },
                "data_binding": { "$ref": "#/$defs/stringArray" }
              }
            },
            "level_advancements": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "usability": { "$ref": "#/$defs/stringArray" },
                "information_architecture": { "$ref": "#/$defs/stringArray" },
                "interaction_depth": { "$ref": "#/$defs/stringArray" },
                "visual_expression": { "$ref": "#/$defs/stringArray" },
                "host_integration": { "$ref": "#/$defs/stringArray" },
                "persistence_lifecycle": { "$ref": "#/$defs/stringArray" }
              }
            },
            "primary_play_surface": { "type": "boolean" }
          }
        },
        "opening_relationship": { "enum": ["separate", "shared_source", "opening_to_runtime", "unified_zero_layer"] },
        "lifecycle_checks": { "type": "array" },
        "runtime": { "enum": ["not_run", "pass", "fail", "blocked"] }
      }
    },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
