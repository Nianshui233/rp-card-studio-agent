{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/character.schema.json",
  "title": "Character Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "status", "role", "identity", "narrative_function", "goals", "value_priority", "internal_conflicts", "boundaries", "behavioral_rules", "speech", "relationships", "knowledge", "state_bindings", "examples", "tags", "source_refs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "locked"] },
    "role": { "enum": ["pending", "primary_character", "companion", "antagonist", "npc", "player_template", "ensemble"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aliases", "age", "species", "occupation", "appearance"],
      "properties": {
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "age": { "type": ["integer", "string", "null"] },
        "species": { "type": "string" },
        "occupation": { "type": "string" },
        "appearance": { "$ref": "#/$defs/stringList" }
      }
    },
    "narrative_function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "pressure_on_player"],
      "properties": {
        "purpose": { "type": "string" },
        "pressure_on_player": { "type": "string" }
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediate", "long_term", "hidden"],
      "properties": {
        "immediate": { "$ref": "#/$defs/stringList" },
        "long_term": { "$ref": "#/$defs/stringList" },
        "hidden": { "$ref": "#/$defs/stringList" }
      }
    },
    "psychology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needs", "fears", "weaknesses", "biases", "self_deceptions"],
      "properties": {
        "needs": { "$ref": "#/$defs/stringList" },
        "fears": { "$ref": "#/$defs/stringList" },
        "weaknesses": { "$ref": "#/$defs/stringList" },
        "biases": { "$ref": "#/$defs/stringList" },
        "self_deceptions": { "$ref": "#/$defs/stringList" }
      }
    },
    "value_priority": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "rank"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "value": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "internal_conflicts": { "$ref": "#/$defs/stringList" },
    "boundaries": { "$ref": "#/$defs/stringList" },
    "behavioral_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "response", "never", "visibility"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "when": { "type": "string", "minLength": 1 },
          "assessment": { "type": "string" },
          "response": { "type": "string", "minLength": 1 },
          "never": { "$ref": "#/$defs/stringList" },
          "visibility": { "enum": ["player", "gm", "model"] }
        }
      }
    },
    "stress_ladder": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rank", "behavior", "escalation_triggers", "deescalation"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "rank": { "type": "integer", "minimum": 1 },
          "behavior": { "type": "string", "minLength": 1 },
          "escalation_triggers": { "$ref": "#/$defs/stringList" },
          "deescalation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ooc_guardrails": { "$ref": "#/$defs/stringList" },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "rhythm", "habits", "avoid"],
      "properties": {
        "register": { "type": "string" },
        "rhythm": { "type": "string" },
        "address": { "type": "string" },
        "habits": { "$ref": "#/$defs/stringList" },
        "avoid": { "$ref": "#/$defs/stringList" }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_ref", "public_relation", "private_relation", "behavioral_effect"],
        "properties": {
          "target_ref": { "type": "string", "pattern": "^(character|player):[a-z][a-z0-9_]*$" },
          "public_relation": { "type": "string" },
          "private_relation": { "type": "string" },
          "behavioral_effect": { "type": "string" },
          "change_basis": { "type": "string" },
          "prohibited_shortcuts": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_visible", "gm_only", "model_only"],
      "properties": {
        "player_visible": { "$ref": "#/$defs/stringList" },
        "gm_only": { "$ref": "#/$defs/stringList" },
        "model_only": { "$ref": "#/$defs/stringList" },
        "mistaken": { "$ref": "#/$defs/stringList" },
        "forbidden": { "$ref": "#/$defs/stringList" }
      }
    },
    "state_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "purpose", "access"],
        "properties": {
          "source_path": { "$ref": "#/$defs/path" },
          "purpose": { "type": "string", "minLength": 1 },
          "access": { "enum": ["read", "write", "read_write"] }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context", "line", "demonstrates"],
        "properties": {
          "context": { "type": "string", "minLength": 1 },
          "line": { "type": "string", "minLength": 1 },
          "demonstrates": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nsfw": { "type": "object", "minProperties": 1 },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "locked" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "role": { "not": { "const": "pending" } } }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "path": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
