{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/ui-bindings.schema.json",
  "title": "UI Bindings Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "ui_bindings"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "status": { "enum": ["draft", "locked"] },
    "ui_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bindings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "component_ref", "slot", "source_path", "presentation", "label", "missing_value", "priority", "collection"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "component_ref": { "type": "string", "pattern": "^ui_component:[a-z][a-z0-9_]*$" },
              "slot": { "$ref": "#/$defs/id" },
              "source_path": { "$ref": "#/$defs/sourcePath" },
              "presentation": { "enum": ["text", "number", "progress", "meter", "badge", "tags", "record_cards", "list", "timeline", "equipment_grid", "relationship_cards", "task_list", "evidence_board", "map_nodes", "resource_meter"] },
              "label": { "type": "string", "minLength": 1 },
              "missing_value": { "type": "string" },
              "priority": { "type": "integer", "minimum": 0 },
              "range": {
                "type": "object", "additionalProperties": false, "required": ["minimum", "maximum"],
                "properties": { "minimum": { "type": "number" }, "maximum": { "type": "number" }, "reverse": { "type": "boolean" } }
              },
              "tones": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["operator", "value", "tone"],
                  "properties": { "operator": { "enum": ["lt", "lte", "eq", "gte", "gt"] }, "value": {}, "tone": { "enum": ["neutral", "primary", "success", "warning", "danger"] } }
                }
              },
              "collection": {
                "type": "object", "additionalProperties": false, "required": ["empty", "limit", "sort"],
                "properties": { "empty": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 500 }, "sort": { "enum": ["source", "key_asc", "key_desc", "value_asc", "value_desc"] } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "sourcePath": { "type": "string", "pattern": "^[a-zA-Z_\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff-]*(\\.[a-zA-Z_\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff-]*)+$" }
  }
}
