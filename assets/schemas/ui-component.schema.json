{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/ui-component.schema.json",
  "title": "UI Component Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "ui_component"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "status": { "enum": ["draft", "locked"] },
    "ui_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "role", "preset", "trigger", "data_contract", "binding_refs", "interactions", "content", "layout", "states", "source", "delivery", "acceptance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["entry", "guide", "setup", "dashboard", "workspace", "narrative_component", "notification"] },
        "preset": { "enum": ["launch_screen", "introduction_page", "opening_selector", "player_setup", "status_terminal", "update_report", "roll_result", "choice_panel", "task_center", "inventory_center", "relationship_center", "intelligence_center", "investigation_board", "map_center", "battle_report", "notification", "custom_panel"] },
        "trigger": {
          "type": "object", "additionalProperties": false, "required": ["kind", "marker", "producer"],
          "properties": {
            "kind": { "enum": ["placeholder", "self_closing", "block"] },
            "marker": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
            "producer": { "enum": ["opening", "model", "runtime"] }
          }
        },
        "data_contract": {
          "type": "object", "additionalProperties": false, "required": ["mode", "payload_format"],
          "properties": { "mode": { "enum": ["none", "stat_data", "current_message", "stat_data_and_message"] }, "payload_format": { "enum": ["none", "json", "text", "lines"] } }
        },
        "binding_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "interactions": { "type": "array", "items": { "enum": ["static", "local_interaction", "message_read", "message_write", "slash_command", "opening_swipe", "host_fragile"] }, "uniqueItems": true },
        "content": {
          "type": "object", "additionalProperties": false, "required": ["eyebrow", "title", "subtitle", "body", "primary_action", "secondary_action"],
          "properties": {
            "eyebrow": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "subtitle": { "type": "string" }, "body": { "type": "array", "items": { "type": "string" } },
            "primary_action": { "type": ["string", "null"] }, "secondary_action": { "type": ["string", "null"] }
          }
        },
        "layout": {
          "type": "object", "additionalProperties": false, "required": ["kind", "groups"],
          "properties": {
            "kind": { "enum": ["hero", "article", "form", "tabs", "grid", "split", "timeline", "board", "compact"] },
            "groups": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "binding_refs", "collapsed"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1 }, "binding_refs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "collapsed": { "type": "boolean" } } }
            }
          }
        },
        "states": {
          "type": "object", "additionalProperties": false, "required": ["loading", "empty", "error", "degraded"],
          "properties": { "loading": { "type": "string", "minLength": 1 }, "empty": { "type": "string", "minLength": 1 }, "error": { "type": "string", "minLength": 1 }, "degraded": { "type": "string", "minLength": 1 } }
        },
        "source": {
          "type": "object", "additionalProperties": false, "required": ["mode", "html", "css", "js"],
          "properties": { "mode": { "enum": ["generated", "inline"] }, "html": { "type": "string" }, "css": { "type": "string" }, "js": { "type": "string" } }
        },
        "delivery": {
          "type": "object", "additionalProperties": false, "required": ["surface", "adapter", "level", "run_on_edit", "min_depth", "max_depth"],
          "properties": {
            "surface": { "const": "message" }, "adapter": { "const": "tavern_helper_message" }, "level": { "enum": ["host_required", "specification"] },
            "run_on_edit": { "const": true }, "min_depth": { "type": ["integer", "null"], "minimum": 0 }, "max_depth": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "acceptance": {
          "type": "object", "additionalProperties": false, "required": ["runtime", "fallback"],
          "properties": { "runtime": { "enum": ["not_run", "required"] }, "fallback": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
}
