{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/assembly.schema.json",
  "title": "RP Card Assembly Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "worldbook_manifest",
    "media_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "draft",
        "locked"
      ]
    },
    "worldbook_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "scan_depth": {
          "type": "null"
        },
        "token_budget": {
          "type": "null"
        },
        "recursive_scanning": {
          "const": false
        },
        "preserve_imported_entries": {
          "type": "boolean"
        },
        "duplicate_policy": {
          "enum": [
            "error",
            "keep_imported",
            "replace_imported"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worldbookEntry"
          }
        }
      }
    },
    "media_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "assets"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaAsset"
          }
        }
      }
    },
    "runtime_manifest": {
      "$ref": "#/$defs/runtimeManifest"
    },
    "extensions": {
      "type": "object"
    },
    "card_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "content",
        "source_refs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "core_world_contract",
            "compact_package_entry",
            "preserve_imported"
          ]
        },
        "content": {
          "type": "string"
        },
        "source_refs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "card_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personality": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "mes_example": {
          "type": "string"
        },
        "creator_notes": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "post_history_instructions": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "runtimeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "regex_scripts",
        "tavern_helper_scripts",
        "extension_fields"
      ],
      "properties": {
        "mode": {
          "const": "authored"
        },
        "regex_scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authoredRegex"
          }
        },
        "tavern_helper_scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authoredHelperNode"
          }
        },
        "extension_fields": {
          "type": "object"
        }
      }
    },
    "authoredRegex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "script_name",
        "find_regex",
        "placement",
        "disabled",
        "markdown_only",
        "prompt_only",
        "run_on_edit",
        "substitute_regex",
        "min_depth",
        "max_depth"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "script_name": {
          "type": "string",
          "minLength": 1
        },
        "find_regex": {
          "type": "string",
          "minLength": 2
        },
        "replace_string": {
          "type": "string"
        },
        "replace_file": {
          "type": "string",
          "minLength": 1
        },
        "wrap_as_html_codeblock": {
          "type": "boolean"
        },
        "trim_strings": {
          "$ref": "#/$defs/stringList"
        },
        "placement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        },
        "disabled": {
          "type": "boolean"
        },
        "markdown_only": {
          "type": "boolean"
        },
        "prompt_only": {
          "type": "boolean"
        },
        "run_on_edit": {
          "type": "boolean"
        },
        "substitute_regex": {
          "type": "integer"
        },
        "min_depth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_depth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "collision": {
          "enum": [
            "error",
            "replace",
            "keep"
          ]
        }
      }
    },
    "authoredHelperScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "content": {
          "type": "string"
        },
        "content_file": {
          "type": "string",
          "minLength": 1
        },
        "info": {
          "type": "string"
        },
        "button": {
          "type": "object"
        },
        "data": {
          "type": "object"
        },
        "export_with": {
          "type": "object"
        },
        "collision": {
          "enum": [
            "error",
            "replace",
            "keep"
          ]
        },
        "type": {
          "const": "script"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "registered_source",
            "inline"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "pattern": "^(?:|/(?:[^~/]|~[01])*)?(?:/(?:[^~/]|~[01])*)*$"
        },
        "content": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "registered_source"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "inline"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "type": "string"
              }
            },
            "required": [
              "content"
            ]
          }
        }
      ]
    },
    "worldbookEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "source",
        "enabled",
        "activation",
        "insertion",
        "probability",
        "scan_depth",
        "recursion",
        "recipient",
        "visibility",
        "fallback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "enabled": {
          "type": "boolean"
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "primary_keys",
            "secondary_keys",
            "selective",
            "logic",
            "case_sensitive",
            "match_whole_words"
          ],
          "properties": {
            "mode": {
              "enum": [
                "constant",
                "keywords"
              ]
            },
            "primary_keys": {
              "$ref": "#/$defs/stringList"
            },
            "secondary_keys": {
              "$ref": "#/$defs/stringList"
            },
            "selective": {
              "type": "boolean"
            },
            "logic": {
              "enum": [
                "any",
                "all",
                "not_any",
                "not_all"
              ]
            },
            "case_sensitive": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "match_whole_words": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "match_persona_description": {
              "type": "boolean"
            },
            "match_character_description": {
              "type": "boolean"
            },
            "match_character_personality": {
              "type": "boolean"
            },
            "match_character_depth_prompt": {
              "type": "boolean"
            },
            "match_scenario": {
              "type": "boolean"
            },
            "match_creator_notes": {
              "type": "boolean"
            }
          }
        },
        "insertion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "order",
            "depth",
            "role"
          ],
          "properties": {
            "position": {
              "enum": [
                "before_char",
                "after_char",
                "before_example",
                "after_example",
                "author_note_top",
                "author_note_bottom",
                "at_depth",
                "outlet"
              ]
            },
            "order": {
              "type": "integer"
            },
            "depth": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "role": {
              "enum": [
                "system",
                "user",
                "assistant"
              ]
            },
            "outlet_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "use_probability": {
          "type": "boolean"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "scan_depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "recursion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prevent_incoming",
            "prevent_outgoing",
            "delay_until_recursion"
          ],
          "properties": {
            "prevent_incoming": {
              "type": "boolean"
            },
            "prevent_outgoing": {
              "type": "boolean"
            },
            "delay_until_recursion": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              ]
            }
          }
        },
        "recipient": {
          "const": "shared"
        },
        "visibility": {
          "const": "model"
        },
        "ignore_budget": {
          "type": "boolean"
        },
        "sticky": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cooldown": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "delay": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "group": {
          "type": "string"
        },
        "group_override": {
          "type": "boolean"
        },
        "group_weight": {
          "type": [
            "number",
            "null"
          ]
        },
        "use_group_scoring": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vectorized": {
          "type": "boolean"
        },
        "automation_id": {
          "type": "string"
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "token_budget": {
          "type": "null"
        },
        "fallback": {
          "enum": [
            "skip",
            "block"
          ]
        },
        "character_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "avatar_stems",
            "tag_ids",
            "is_exclude"
          ],
          "properties": {
            "avatar_stems": {
              "$ref": "#/$defs/stringList"
            },
            "tag_ids": {
              "$ref": "#/$defs/stringList"
            },
            "is_exclude": {
              "type": "boolean"
            }
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "delivery",
        "consumers",
        "fallback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "portrait",
            "background",
            "sprite",
            "audio",
            "video",
            "ui_image",
            "font",
            "other"
          ]
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "url"
              ],
              "properties": {
                "kind": {
                  "const": "url"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          ]
        },
        "delivery": {
          "enum": [
            "embedded",
            "remote",
            "host_required"
          ]
        },
        "preload": {
          "enum": [
            "none",
            "on_opening",
            "eager",
            "on_demand"
          ]
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "slot"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "slot": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "fallback": {
          "oneOf": [
            {
              "enum": [
                "skip",
                "text",
                "block"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy"
              ],
              "properties": {
                "strategy": {
                  "enum": [
                    "skip",
                    "text",
                    "asset",
                    "block"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "asset_ref": {
                  "type": "string",
                  "pattern": "^media:[a-z][a-z0-9_]*$"
                }
              }
            }
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "remote"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "url"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "file",
                      "registered_source",
                      "inline"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "delivery": {
                "const": "embedded"
              }
            }
          }
        }
      ]
    },
    "authoredHelperNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/authoredHelperScript"
        },
        {
          "$ref": "#/$defs/authoredHelperFolder"
        }
      ]
    },
    "authoredHelperFolder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "enabled",
        "scripts"
      ],
      "properties": {
        "type": {
          "const": "folder"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authoredHelperScript"
          }
        },
        "collision": {
          "enum": [
            "error",
            "replace",
            "keep"
          ]
        }
      }
    }
  }
}
