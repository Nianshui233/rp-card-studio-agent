{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/mvu.schema.json",
  "title": "MVU and EJS Runtime Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "mvu",
    "ejs",
    "runtime_target",
    "dependencies",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "3.0.0",
        "3.1.0"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "locked"
      ]
    },
    "mvu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "route",
        "state_root",
        "framework",
        "files",
        "update_strategy",
        "implementation_notes"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "route": {
          "enum": [
            "none",
            "native_schema",
            "mvu_zod",
            "hybrid",
            "existing"
          ]
        },
        "state_root": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delivery",
            "loader_script_id",
            "expected_global"
          ],
          "properties": {
            "delivery": {
              "enum": [
                "none",
                "card_script",
                "host_required",
                "existing"
              ]
            },
            "loader_script_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "loader_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "expected_global": {
              "type": [
                "string",
                "null"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_values",
            "schema_script",
            "update_rules",
            "output_format",
            "config_override",
            "helper_scripts",
            "supporting_files"
          ],
          "properties": {
            "initial_values": {
              "type": [
                "string",
                "null"
              ]
            },
            "schema_script": {
              "type": [
                "string",
                "null"
              ]
            },
            "update_rules": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_format": {
              "type": [
                "string",
                "null"
              ]
            },
            "config_override": {
              "type": [
                "string",
                "null"
              ]
            },
            "helper_scripts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "supporting_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "update_strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "response_transport",
            "operation_dialect"
          ],
          "properties": {
            "mode": {
              "enum": [
                "same_turn",
                "extra_model",
                "existing"
              ]
            },
            "response_transport": {
              "enum": [
                "chat_message",
                "tool_calling",
                "json_schema",
                "json_object",
                "existing"
              ]
            },
            "operation_dialect": {
              "enum": [
                "lodash_commands",
                "mvu_json_patch",
                "mixed",
                "existing"
              ]
            },
            "display_cleanup": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "evidence"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "card_regex",
                    "framework",
                    "host_regex",
                    "existing"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "update_variable": {
                  "$ref": "#/$defs/cleanupChannel"
                },
                "status_placeholder": {
                  "$ref": "#/$defs/cleanupChannel"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "enum": [
                          "framework",
                          "host_regex",
                          "existing"
                        ]
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  "then": {
                    "properties": {
                      "evidence": {
                        "type": "array",
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prompt_cleanup": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "evidence"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "card_regex",
                    "framework",
                    "host_regex",
                    "existing"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "update_variable": {
                  "$ref": "#/$defs/cleanupChannel"
                },
                "status_placeholder": {
                  "$ref": "#/$defs/cleanupChannel"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "enum": [
                          "framework",
                          "host_regex",
                          "existing"
                        ]
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  "then": {
                    "properties": {
                      "evidence": {
                        "type": "array",
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "implementation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initialization",
            "persistence",
            "cleanup",
            "side_effects",
            "version_matrix",
            "remote_dependencies"
          ],
          "properties": {
            "initialization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry_pattern",
                "enabled_worldbooks",
                "opening_override",
                "root_collision_policy"
              ],
              "properties": {
                "entry_pattern": {
                  "type": "string",
                  "minLength": 1
                },
                "enabled_worldbooks": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "character_primary",
                      "character_additional",
                      "global",
                      "chat",
                      "persona",
                      "existing"
                    ]
                  }
                },
                "opening_override": {
                  "enum": [
                    "none",
                    "character_primary_replace",
                    "merge",
                    "existing"
                  ]
                },
                "root_collision_policy": {
                  "enum": [
                    "unique_top_level_keys",
                    "intentional_override",
                    "existing"
                  ]
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "swipe_aware",
                "readback"
              ],
              "properties": {
                "scope": {
                  "enum": [
                    "message",
                    "chat_compat",
                    "existing"
                  ]
                },
                "swipe_aware": {
                  "type": "boolean"
                },
                "readback": {
                  "enum": [
                    "current_message",
                    "latest_valid_snapshot",
                    "existing"
                  ]
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "cleanup": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "snapshot_cleanup",
                "replay_restore",
                "history_missing_fallback"
              ],
              "properties": {
                "snapshot_cleanup": {
                  "enum": [
                    "framework",
                    "disabled",
                    "existing"
                  ]
                },
                "replay_restore": {
                  "enum": [
                    "framework",
                    "disabled",
                    "existing"
                  ]
                },
                "history_missing_fallback": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "side_effects": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "global_worldbook_settings",
                "notes"
              ],
              "properties": {
                "global_worldbook_settings": {
                  "enum": [
                    "framework_changes",
                    "disabled",
                    "existing",
                    "unknown"
                  ]
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "version_matrix": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base_loader",
                "tool_calling",
                "custom_request_body",
                "batch_requests"
              ],
              "properties": {
                "base_loader": {
                  "type": "string",
                  "minLength": 1
                },
                "tool_calling": {
                  "type": "string",
                  "minLength": 1
                },
                "custom_request_body": {
                  "type": "string",
                  "minLength": 1
                },
                "batch_requests": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "remote_dependencies": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "loader",
                "transitive_imports",
                "runtime_evidence"
              ],
              "properties": {
                "loader": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "transitive_imports": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "runtime_evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "ejs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "engine",
        "templates",
        "implementation_notes"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "engine": {
          "enum": [
            "st_prompt_template",
            "existing",
            "custom",
            "none"
          ]
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "host",
              "purpose"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "host": {
                "enum": [
                  "character_book",
                  "tavern_helper_script",
                  "existing"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "fallback": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phase": {
                "enum": [
                  "before_prompt",
                  "prompt",
                  "after_prompt",
                  "runtime",
                  "existing"
                ]
              },
              "reads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "invokes_entries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "output_target": {
                "type": "string"
              },
              "cache": {
                "enum": [
                  "none",
                  "turn",
                  "chat",
                  "existing"
                ]
              }
            }
          }
        },
        "implementation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime_target": {
      "type": "object",
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "cleanupChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "evidence"
      ],
      "properties": {
        "mode": {
          "enum": [
            "card_regex",
            "framework",
            "host_regex",
            "existing"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "framework",
                  "host_regex",
                  "existing"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "3.1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "mvu": {
            "type": "object",
            "required": [
              "runtime_contract"
            ],
            "properties": {
              "runtime_contract": {
                "$ref": "#/properties/mvu/properties/runtime_contract"
              }
            }
          }
        }
      }
    }
  ]
}
