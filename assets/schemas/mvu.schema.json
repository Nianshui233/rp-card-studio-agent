{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/mvu.schema.json",
  "title": "Direct MVU and EJS Source Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "mvu", "ejs", "runtime_target", "dependencies", "source_refs"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "status": { "enum": ["draft", "locked"] },
    "mvu": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "state_root", "files", "implementation_notes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "state_root": { "type": "string", "minLength": 1 },
        "files": {
          "type": "object",
          "additionalProperties": true,
          "required": ["initial_values", "schema_script", "update_rules", "output_format", "helper_scripts", "supporting_files"],
          "properties": {
            "initial_values": { "type": ["string", "null"] },
            "schema_script": { "type": ["string", "null"] },
            "update_rules": { "type": ["string", "null"] },
            "output_format": { "type": ["string", "null"] },
            "helper_scripts": { "type": "array", "items": { "type": "string" } },
            "supporting_files": { "type": "array", "items": { "type": "string" } }
          }
        },
        "implementation_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ejs": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "engine", "files", "implementation_notes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "enum": ["st_prompt_template", "existing", "custom", "none"] },
        "files": { "type": "array", "items": { "type": "string" } },
        "implementation_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runtime_target": { "type": "object" },
    "dependencies": { "type": "array" },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  }
}