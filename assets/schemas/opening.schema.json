{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/opening.schema.json",
  "title": "Narrative and Opening Source",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "narrative",
    "openings",
    "dialogue_examples",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "status": {
      "enum": [
        "draft",
        "locked"
      ]
    },
    "narrative": {
      "type": "object"
    },
    "opening_ui": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "marker",
        "file",
        "render_route",
        "render_ref",
        "render_evidence",
        "experience_level",
        "theme_direction",
        "device_priority",
        "journey",
        "fallback",
        "runtime"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authoring_mode": {
          "enum": [
            "direct_html",
            "multi_file_html",
            "compiled_frontend",
            "existing_build"
          ]
        },
        "app_manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "render_route": {
          "enum": [
            "regex_replace",
            "helper_script",
            "ejs",
            "inline_html",
            "framework",
            "existing"
          ]
        },
        "render_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "render_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "opening_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "experience_level": {
          "enum": [
            "light",
            "light_medium",
            "medium",
            "heavy",
            "super_heavy"
          ]
        },
        "theme_direction": {
          "type": "string"
        },
        "device_priority": {
          "enum": [
            "desktop",
            "mobile",
            "equal"
          ]
        },
        "journey": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "runtime": {
          "enum": [
            "not_run",
            "pass",
            "fail",
            "blocked"
          ]
        },
        "frontend_build": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "mode",
            "source_root",
            "package_file",
            "lock_file",
            "build_command",
            "output",
            "runtime_format",
            "expected_sha256"
          ],
          "properties": {
            "mode": {
              "const": "compiled_frontend"
            },
            "source_root": {
              "type": "string",
              "minLength": 1
            },
            "package_file": {
              "type": "string",
              "minLength": 1
            },
            "lock_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "build_command": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "string",
              "minLength": 1
            },
            "runtime_format": {
              "enum": [
                "standalone_document",
                "message_surface"
              ]
            },
            "expected_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "creation_bridge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "input_fields",
        "bindings",
        "commit"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "input_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "commit": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "route",
            "marker",
            "source_file",
            "api_ref",
            "readback",
            "failure_fallback"
          ],
          "properties": {
            "route": {
              "enum": [
                "none",
                "mvu_api",
                "update_message",
                "helper_script",
                "user_message",
                "existing",
                "worldbook_api",
                "hybrid"
              ]
            },
            "marker": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "readback": {
              "type": "string"
            },
            "failure_fallback": {
              "type": "string"
            },
            "worldbook_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "entry_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "write_mode": {
              "enum": [
                "create",
                "update",
                "upsert",
                "none"
              ]
            },
            "worldbook_readback": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "display_name",
          "is_default",
          "visible_text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "is_default": {
            "type": "boolean"
          },
          "visible_text": {
            "type": "string",
            "minLength": 1
          },
          "prompt_visible_text": {
            "type": "string"
          },
          "initial_state_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dialogue_examples": {
      "type": "array"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opening_transition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "route",
        "source_message",
        "target_opening",
        "api_ref",
        "evidence"
      ],
      "properties": {
        "route": {
          "enum": [
            "none",
            "swipe_switch",
            "message_replace",
            "helper_script",
            "existing"
          ]
        },
        "source_message": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "target_opening": {
          "type": [
            "string",
            "null"
          ]
        },
        "api_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
