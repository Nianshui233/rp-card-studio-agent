{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/opening.schema.json",
  "title": "Narrative and Opening Source",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "narrative", "openings", "dialogue_examples", "source_refs"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "status": { "enum": ["draft", "locked"] },
    "narrative": { "type": "object" },
    "opening_ui": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "marker", "file", "render_route", "render_ref", "render_evidence", "experience_level", "theme_direction", "device_priority", "journey", "fallback", "runtime"],
      "properties": {
        "enabled": { "type": "boolean" },
        "authoring_mode": { "enum": ["direct_html", "multi_file_html", "compiled_frontend", "existing_build"] },
        "app_manifest": { "type": ["string", "null"] },
        "marker": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "render_route": { "enum": ["regex_replace", "helper_script", "ejs", "inline_html", "framework", "existing"] },
        "render_ref": { "type": ["string", "null"] },
        "render_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "opening_id": { "type": ["string", "null"] },
        "experience_level": { "enum": ["light", "light_medium", "medium", "heavy", "super_heavy"] },
        "theme_direction": { "type": "string" },
        "device_priority": { "enum": ["desktop", "mobile", "equal"] },
        "journey": { "type": "string" },
        "fallback": { "type": "string" },
        "runtime": { "enum": ["not_run", "pass", "fail", "blocked"] }
      }
    },
    "creation_bridge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "input_fields", "bindings", "commit"],
      "properties": {
        "enabled": { "type": "boolean" },
        "input_fields": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "bindings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "commit": {
          "type": "object",
          "additionalProperties": true,
          "required": ["route", "marker", "source_file", "api_ref", "readback", "failure_fallback"],
          "properties": {
            "route": { "enum": ["none", "mvu_api", "update_message", "helper_script", "user_message", "existing"] },
            "marker": { "type": ["string", "null"] },
            "source_file": { "type": ["string", "null"] },
            "api_ref": { "type": ["string", "null"] },
            "readback": { "type": "string" },
            "failure_fallback": { "type": "string" }
          }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "display_name", "is_default", "visible_text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "is_default": { "type": "boolean" },
          "visible_text": { "type": "string", "minLength": 1 },
          "prompt_visible_text": { "type": "string" },
          "initial_state_ref": { "type": ["string", "null"] }
        }
      }
    },
    "dialogue_examples": { "type": "array" },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  }
}
