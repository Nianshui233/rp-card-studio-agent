{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/state.schema.json",
  "title": "RP Card Studio Technical State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "active_stage", "stages", "decision_locks", "delegations", "cross_stage_backlog", "dirty_sources", "last_build", "validation", "transaction", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "active_stage": { "$ref": "#/$defs/stage" },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "positioning", "materials", "worldbuilding", "character", "systems", "scenes", "mvu_ejs", "narrative_opening", "status_ui", "integration"],
      "properties": {
        "preflight": { "$ref": "#/$defs/stageState" },
        "positioning": { "$ref": "#/$defs/stageState" },
        "materials": { "$ref": "#/$defs/stageState" },
        "worldbuilding": { "$ref": "#/$defs/stageState" },
        "character": { "$ref": "#/$defs/stageState" },
        "systems": { "$ref": "#/$defs/stageState" },
        "scenes": { "$ref": "#/$defs/stageState" },
        "mvu_ejs": { "$ref": "#/$defs/stageState" },
        "narrative_opening": { "$ref": "#/$defs/stageState" },
        "status_ui": { "$ref": "#/$defs/stageState" },
        "integration": { "$ref": "#/$defs/stageState" }
      }
    },
    "decision_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "value_hash", "locked_by", "locked_at"],
        "properties": {
          "decision_id": { "$ref": "#/$defs/decisionId" },
          "value_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "locked_by": { "enum": ["user", "ai_delegation", "imported"] },
          "locked_at": { "$ref": "#/$defs/dateTime" }
        }
      }
    },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "granted_at", "active"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "scope": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" }, "uniqueItems": true },
          "granted_at": { "$ref": "#/$defs/dateTime" },
          "active": { "type": "boolean" }
        }
      }
    },
    "cross_stage_backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project_decision_id", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "project_decision_id": { "$ref": "#/$defs/decisionId" },
          "status": { "enum": ["open", "blocking", "deferred", "resolved"] }
        }
      }
    },
    "dirty_sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "last_build": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "source_revision", "status", "finished_at", "manifest"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "source_revision": { "type": "integer", "minimum": 0 },
            "status": { "enum": ["pass", "fail", "warning"] },
            "finished_at": { "$ref": "#/$defs/dateTime" },
            "manifest": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runs"],
      "properties": {
        "status": { "enum": ["not_run", "pass", "fail", "warning", "blocked"] },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "evidence_level", "status", "report"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "evidence_level": { "enum": ["offline", "artifact", "runtime"] },
              "status": { "enum": ["pass", "fail", "warning", "not_run", "blocked"] },
              "report": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "transaction": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "operation", "candidate_path", "started_at"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "operation": { "enum": ["init", "unpack", "build", "pack", "migration"] },
            "candidate_path": { "type": "string", "minLength": 1 },
            "started_at": { "$ref": "#/$defs/dateTime" }
          }
        }
      ]
    },
    "updated_at": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/dateTime" }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "decisionId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$" },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "stage": { "enum": ["preflight", "positioning", "materials", "worldbuilding", "character", "systems", "scenes", "mvu_ejs", "narrative_opening", "status_ui", "integration"] },
    "stageState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "round", "summary"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "awaiting_user", "complete", "skipped", "blocked"] },
        "round": { "type": "integer", "minimum": 0 },
        "summary": { "type": ["string", "null"] }
      }
    }
  }
}
