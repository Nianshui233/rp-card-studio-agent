{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/positioning.schema.json",
  "title": "RP Project Positioning",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "id", "status", "project_title", "card_mode",
    "premise", "card_entry", "core_experiences", "tone",
    "play_rhythm", "autonomous_world", "scope_notes", "source_refs"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "status": { "enum": ["draft", "locked"] },
    "project_title": { "type": "string", "minLength": 1 },
    "card_mode": {
      "enum": [
        "pending", "single_character_card", "world_package", "scenario_package",
        "gameplay_package", "ensemble_package", "multi_character_package",
        "narrator_package", "facilitator_package",
        "world_scenario_with_anchor_character", "gameplay_with_anchor_character",
        "hybrid_package"
      ]
    },
    "premise": { "type": "string" },
    "card_entry": { "type": "string" },
    "core_experiences": { "type": "array", "items": { "type": "string" } },
    "tone": { "type": "array", "items": { "type": "string" } },
    "play_rhythm": { "type": "string" },
    "autonomous_world": { "type": "string" },
    "scope_notes": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "locked" } } },
    "then": {
      "properties": {
        "card_mode": { "not": { "const": "pending" } },
        "card_entry": { "type": "string", "minLength": 1 }
      }
    }
  }]
}
