{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-card-studio.local/schemas/world.schema.json",
  "title": "World Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "status",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "locked"
      ]
    },
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "scale",
        "time_scope",
        "space_scope",
        "public_reality"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "scale": {
          "enum": [
            "pending",
            "personal",
            "local",
            "regional",
            "global",
            "multiverse"
          ]
        },
        "time_scope": {
          "type": "string"
        },
        "space_scope": {
          "type": "string"
        },
        "public_reality": {
          "type": "string"
        }
      }
    },
    "fundamental_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "society": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "norms",
        "institutions",
        "factions"
      ],
      "properties": {
        "norms": {
          "$ref": "#/$defs/contentList"
        },
        "institutions": {
          "$ref": "#/$defs/entityList"
        },
        "factions": {
          "$ref": "#/$defs/entityList"
        }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locations"
      ],
      "properties": {
        "locations": {
          "$ref": "#/$defs/entityList"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "$ref": "#/$defs/entityList"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicly_known",
        "gm_only",
        "model_only"
      ],
      "properties": {
        "publicly_known": {
          "$ref": "#/$defs/contentList"
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "fact",
              "access"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "fact": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "gm_only": {
          "$ref": "#/$defs/contentList"
        },
        "model_only": {
          "$ref": "#/$defs/contentList"
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariants",
        "open_questions"
      ],
      "properties": {
        "invariants": {
          "$ref": "#/$defs/contentList"
        },
        "open_questions": {
          "$ref": "#/$defs/contentList"
        }
      }
    },
    "hooks": {
      "$ref": "#/$defs/contentList"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object"
    },
    "world_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rp_format",
        "ai_core_instruction",
        "genre",
        "subgenres",
        "tone",
        "tone_notes",
        "narrative_tags",
        "tone_red_lines"
      ],
      "properties": {
        "rp_format": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "subgenres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone": {
          "type": "string"
        },
        "tone_notes": {
          "type": "string"
        },
        "narrative_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone_red_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ai_core_instruction": {
          "type": "string"
        }
      }
    },
    "setting_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "era",
        "world_scale",
        "main_locations",
        "environment"
      ],
      "properties": {
        "era": {
          "type": "string"
        },
        "world_scale": {
          "type": "string"
        },
        "main_locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "role_in_rp",
              "public_impression",
              "hidden_reality"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string"
              },
              "role_in_rp": {
                "type": "string"
              },
              "public_impression": {
                "type": "string"
              },
              "hidden_reality": {
                "type": "string"
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "climate_and_terrain",
            "resource_situation",
            "scarce_resources",
            "everyday_technology",
            "transportation",
            "communication",
            "population_scale",
            "environmental_threats"
          ],
          "properties": {
            "climate_and_terrain": {
              "type": "string"
            },
            "resource_situation": {
              "type": "string"
            },
            "scarce_resources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "everyday_technology": {
              "type": "string"
            },
            "transportation": {
              "type": "string"
            },
            "communication": {
              "type": "string"
            },
            "population_scale": {
              "type": "string"
            },
            "environmental_threats": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "information_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public",
        "conditional",
        "secrets",
        "misinformation",
        "revelation_rules",
        "leakage_consequences"
      ],
      "properties": {
        "public": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "fact",
              "access",
              "reveal_trigger",
              "consequence_if_known"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "fact": {
                "type": "string"
              },
              "access": {
                "type": "string"
              },
              "reveal_trigger": {
                "type": "string"
              },
              "consequence_if_known": {
                "type": "string"
              }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "misinformation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revelation_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "leakage_consequences": {
          "type": "string"
        }
      }
    },
    "core_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_situation",
        "sides",
        "escalation_path",
        "personal_conflicts",
        "possible_resolutions",
        "secondary_conflicts"
      ],
      "properties": {
        "current_situation": {
          "type": "string"
        },
        "sides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position",
              "goal",
              "resources",
              "methods",
              "red_line"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string"
              },
              "position": {
                "type": "string"
              },
              "goal": {
                "type": "string"
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "red_line": {
                "type": "string"
              }
            }
          }
        },
        "escalation_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "personal_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "possible_resolutions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondary_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "world_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systems",
        "default_resolution",
        "conflict_priority",
        "recursion_fallback",
        "life_and_death",
        "rare_resources"
      ],
      "properties": {
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "applies_to",
              "can_do",
              "cannot_do",
              "costs",
              "limits",
              "frequency",
              "resolution",
              "edge_cases",
              "priority"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string"
              },
              "applies_to": {
                "type": "string"
              },
              "can_do": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cannot_do": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "costs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "limits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "frequency": {
                "type": "string"
              },
              "resolution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "success",
                  "partial_success",
                  "failure",
                  "critical"
                ],
                "properties": {
                  "success": {
                    "type": "string"
                  },
                  "partial_success": {
                    "type": "string"
                  },
                  "failure": {
                    "type": "string"
                  },
                  "critical": {
                    "type": "string"
                  }
                }
              },
              "edge_cases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "priority": {
                "type": "string"
              }
            }
          }
        },
        "default_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "opposition",
            "repeated_actions",
            "insufficient_information"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "opposition": {
              "type": "string"
            },
            "repeated_actions": {
              "type": "string"
            },
            "insufficient_information": {
              "type": "string"
            }
          }
        },
        "conflict_priority": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recursion_fallback": {
          "type": "string"
        },
        "life_and_death": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "injury_severity",
            "healing_difficulty",
            "death_frequency",
            "reversibility",
            "nonlethal_options"
          ],
          "properties": {
            "injury_severity": {
              "type": "string"
            },
            "healing_difficulty": {
              "type": "string"
            },
            "death_frequency": {
              "type": "string"
            },
            "reversibility": {
              "type": "string"
            },
            "nonlethal_options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "rare_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "production",
            "control",
            "substitutes",
            "black_market"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "production": {
              "type": "string"
            },
            "control": {
              "type": "string"
            },
            "substitutes": {
              "type": "string"
            },
            "black_market": {
              "type": "string"
            }
          }
        }
      }
    },
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "aliases",
          "physiology",
          "lifespan",
          "innate_abilities",
          "innate_limits",
          "population_ratio",
          "social_position",
          "culture",
          "relations_with_others",
          "playable_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "physiology": {
            "type": "string"
          },
          "lifespan": {
            "type": "string"
          },
          "innate_abilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "innate_limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "population_ratio": {
            "type": "string"
          },
          "social_position": {
            "type": "string"
          },
          "culture": {
            "type": "string"
          },
          "relations_with_others": {
            "type": "string"
          },
          "playable_notes": {
            "type": "string"
          }
        }
      }
    },
    "factions_and_society": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factions",
        "faction_relations",
        "social_order"
      ],
      "properties": {
        "factions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "public_goal",
              "hidden_goal",
              "methods",
              "resources",
              "territory_or_influence",
              "internal_conflicts",
              "recruitment_and_members"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string"
              },
              "public_goal": {
                "type": "string"
              },
              "hidden_goal": {
                "type": "string"
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "territory_or_influence": {
                "type": "string"
              },
              "internal_conflicts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "recruitment_and_members": {
                "type": "string"
              },
              "public_reputation": {
                "type": "string"
              }
            }
          }
        },
        "faction_relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overall_balance",
            "bilateral"
          ],
          "properties": {
            "overall_balance": {
              "type": "string"
            },
            "bilateral": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "parties",
                  "relation",
                  "details",
                  "trend",
                  "change_triggers"
                ],
                "properties": {
                  "parties": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "relation": {
                    "type": "string"
                  },
                  "details": {
                    "type": "string"
                  },
                  "trend": {
                    "type": "string"
                  },
                  "change_triggers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "social_order": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class_structure",
            "mobility",
            "law_and_security",
            "justice_and_punishment",
            "marginalized_groups"
          ],
          "properties": {
            "class_structure": {
              "type": "string"
            },
            "mobility": {
              "type": "string"
            },
            "law_and_security": {
              "type": "string"
            },
            "justice_and_punishment": {
              "type": "string"
            },
            "marginalized_groups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "autonomous_motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_momentum",
        "daily_rhythms",
        "active_clocks",
        "faction_agendas",
        "resource_flows",
        "information_flows",
        "offscreen_event_rules",
        "update_cadence"
      ],
      "properties": {
        "current_momentum": {
          "type": "string"
        },
        "daily_rhythms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope_ref",
              "rhythm",
              "participants",
              "visible_signs",
              "disruption_effect"
            ],
            "properties": {
              "scope_ref": { "type": "string" },
              "rhythm": { "type": "string" },
              "participants": { "type": "array", "items": { "type": "string" } },
              "visible_signs": { "type": "array", "items": { "type": "string" } },
              "disruption_effect": { "type": "string" }
            }
          }
        },
        "active_clocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "owner_ref",
              "current_stage",
              "next_step",
              "advance_trigger",
              "deadline",
              "consequence",
              "visible_signs",
              "interference_points"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string" },
              "owner_ref": { "type": "string" },
              "current_stage": { "type": "string" },
              "next_step": { "type": "string" },
              "advance_trigger": { "type": "string" },
              "deadline": { "type": "string" },
              "consequence": { "type": "string" },
              "visible_signs": { "type": "array", "items": { "type": "string" } },
              "interference_points": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "faction_agendas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "faction_ref",
              "current_goal",
              "current_operation",
              "resources_committed",
              "next_action",
              "success_consequence",
              "failure_consequence"
            ],
            "properties": {
              "faction_ref": { "type": "string" },
              "current_goal": { "type": "string" },
              "current_operation": { "type": "string" },
              "resources_committed": { "type": "array", "items": { "type": "string" } },
              "next_action": { "type": "string" },
              "success_consequence": { "type": "string" },
              "failure_consequence": { "type": "string" }
            }
          }
        },
        "resource_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource",
              "source",
              "route",
              "controllers",
              "pressure",
              "disruption_consequence"
            ],
            "properties": {
              "resource": { "type": "string" },
              "source": { "type": "string" },
              "route": { "type": "string" },
              "controllers": { "type": "array", "items": { "type": "string" } },
              "pressure": { "type": "string" },
              "disruption_consequence": { "type": "string" }
            }
          }
        },
        "information_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "information",
              "origin",
              "carriers",
              "spread_pattern",
              "distortion",
              "consequence"
            ],
            "properties": {
              "information": { "type": "string" },
              "origin": { "type": "string" },
              "carriers": { "type": "array", "items": { "type": "string" } },
              "spread_pattern": { "type": "string" },
              "distortion": { "type": "string" },
              "consequence": { "type": "string" }
            }
          }
        },
        "offscreen_event_rules": {
          "type": "array",
          "items": { "type": "string" }
