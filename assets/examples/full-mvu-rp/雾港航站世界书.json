      "comment": "STPT·MVU动态上下文",
      "content": "@@generate_before\n@@always_enabled\n@@activate\n<%_\nconst state = typeof mvu === 'object' && mvu ? mvu.stat_data : null;\nconst show = value => value == null || value === '' ? '未记录' : String(value);\nconst list = value => {\n  const clean = Array.isArray(value) ? value.filter(item => !(item && typeof item === 'object' && item.$arrayMeta === true)) : [];\n  return clean.length ? clean.join('、') : '暂无';\n};\n_%>\n<航站运行摘要>\n世界.区域：<%- show(state?.世界?.区域) %>\n天气与时段：<%- show(state?.世界?.天气) %>，<%- show(state?.世界?.时段) %>\n系统.路线：<%- show(state?.系统?.路线) %>\n任务.主线.名称：<%- show(state?.任务?.主线?.名称) %>；任务.主线.阶段：<%- show(state?.任务?.主线?.阶段) %>\n系统.航站安全度：<%- show(state?.系统?.航站安全度) %>\n系统.雾钟倒计时（分钟）：<%- show(state?.系统?.雾钟倒计时) %>\n关系.洛檀信任：<%- show(state?.关系?.洛檀信任) %>\n线索：<%- list(state?.线索) %>\n玩家公开起点：<%- show(state?.玩家?.称呼) %>／<%- show(state?.玩家?.来历) %>／<%- show(state?.玩家?.专长) %>\n<%- await getwi('雾港航站世界书', '航站共识简报') %>\n</航站运行摘要>",
